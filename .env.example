ANTHROPIC_API_KEY=

# Optional: where data lives (default: ./data) and the rclone archive path.
# PRAMAAN_DATA_DIR=
# PRAMAAN_ARCHIVE_REMOTE=gdrive:pramaan-data

# Free hosted models (no card). Keys come from the provider's site; never commit them.
# Google AI Studio (Gemini free tier). Note: Google may use free-tier prompts to improve its models,
# so send it only public text (judgments), never a user's private draft.
# PRAMAAN_JUDGE_BACKEND=openai
# PRAMAAN_OPENAI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PRAMAAN_OPENAI_PATH=/chat/completions
# PRAMAAN_OPENAI_API_KEY=
# PRAMAAN_JUDGE_MODEL=<a Flash model name shown in AI Studio>

# Optional, only for bench/eval_baseline_llm.py --provider deepseek (paid; a few cents per 120 calls)
# PRAMAAN_DEEPSEEK_API_KEY=
